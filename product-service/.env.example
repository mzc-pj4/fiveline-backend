# product-service 환경변수 예시
# 사용법: cp .env.example .env

# Database
DATABASE_URL=postgresql+psycopg://aiops:aiops_dev_password@localhost:5432/aiops
DB_SCHEMA=product_schema

# JWT (user-service와 같은 secret 사용 — 토큰 검증용)
JWT_SECRET=dev-only-jwt-secret-change-in-prod
JWT_ALGORITHM=HS256

# Service
SERVICE_NAME=product-service
ENVIRONMENT=dev
LOG_LEVEL=INFO
