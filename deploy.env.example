PROJECT=fiveline
ENVIRONMENT=dev

EKS_CLUSTER_NAME=fiveline-dev
K8S_NAMESPACE=fiveline

RDS_ENDPOINT=replace-me.ap-northeast-2.rds.amazonaws.com
RDS_PORT=5432
