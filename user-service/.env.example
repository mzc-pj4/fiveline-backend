# user-service 환경변수 예시
# 사용법: 이 파일을 .env로 복사해서 값 채우기
#   cp .env.example .env

# Database
DATABASE_URL=postgresql+psycopg://fiveline:fiveline@localhost:5432/fiveline
DB_SCHEMA=user_schema

# JWT
JWT_SECRET=dev-only-jwt-secret-change-in-prod
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# Service
SERVICE_NAME=user-service
ENVIRONMENT=dev
LOG_LEVEL=INFO
