# order-service 환경변수 예시
# 사용법: cp .env.example .env

# Database
DATABASE_URL=postgresql+psycopg://aiops:aiops_dev_password@localhost:5432/aiops
DB_SCHEMA=order_schema

# JWT (모든 서비스 공통 secret)
JWT_SECRET=dev-only-jwt-secret-change-in-prod
JWT_ALGORITHM=HS256

# product-service 호출 (장바구니/재고 확인용)
PRODUCT_SERVICE_URL=http://localhost:8002
PRODUCT_SERVICE_TIMEOUT_S=3.0

# Service
SERVICE_NAME=order-service
ENVIRONMENT=dev
LOG_LEVEL=INFO

# 실패·지연 시뮬레이션 (운영 데이터 분석용)
FAILURE_RATE=0.05
SLOW_RATE=0.03
SLOW_RESPONSE_MS_MIN=1500
SLOW_RESPONSE_MS_MAX=3500
