# Local Docker Compose environment.
# Copy this file to .env before running docker compose locally:
#   cp .env.example .env
#
# Do not use these dev secrets in AWS. For EKS/RDS, use deploy.env.example
# as the checklist and inject sensitive values through Kubernetes Secret.

POSTGRES_USER=aiops
POSTGRES_PASSWORD=aiops_dev_password
POSTGRES_DB=aiops

JWT_SECRET=dev-only-jwt-secret-change-in-prod
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

ENVIRONMENT=dev
LOG_LEVEL=INFO

USER_SERVICE_NAME=user-service
PRODUCT_SERVICE_NAME=product-service
ORDER_SERVICE_NAME=order-service

USER_SERVICE_DB_SCHEMA=user_schema
PRODUCT_SERVICE_DB_SCHEMA=product_schema
ORDER_SERVICE_DB_SCHEMA=order_schema

PRODUCT_SERVICE_URL=http://product-service:8000
PRODUCT_SERVICE_TIMEOUT_S=3.0

FAILURE_RATE=0.05
SLOW_RATE=0.03
SLOW_RESPONSE_MS_MIN=1500
SLOW_RESPONSE_MS_MAX=3500
